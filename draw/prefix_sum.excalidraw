      "isDeleted": false,
      "boundElements": null,
      "updated": 1726411453054,
      "link": null,
      "locked": false,
      "text": "initialize count = 0\ninitialize prefix_sum = 0\ninitialize hashmap = {0: 1}  // for handling sum == k at the start\n\nfor each num in array:\n    update prefix_sum += num\n    if (prefix_sum - k) exists in hashmap:\n        increase count by hashmap[prefix_sum - k]  // count subarrays ending here with sum == k\n    update hashmap[prefix_sum] += 1\n\nreturn count\n",
      "fontSize": 41.666666666666686,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 589.9999999999998,
      "containerId": null,
      "originalText": "initialize count = 0\ninitialize prefix_sum = 0\ninitialize hashmap = {0: 1}  // for handling sum == k at the start\n\nfor each num in array:\n    update prefix_sum += num\n    if (prefix_sum - k) exists in hashmap:\n        increase count by hashmap[prefix_sum - k]  // count subarrays ending here with sum == k\n    update hashmap[prefix_sum] += 1\n\nreturn count\n",
      "lineHeight": 1.2
    },
